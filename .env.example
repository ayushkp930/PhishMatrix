# Use project environment variables on Vercel. Keep local values in .env.
VT_API_KEY=
WEBRISK_API_KEY=
ABUSEIPDB_API_KEY=
URLSCAN_API_KEY=
OTX_API_KEY=
PULSEDIVE_API_KEY=
GREYNOISE_API_KEY=
SHODAN_API_KEY=
MALSHARE_API_KEY=
MAILBOXLAYER_API_KEY=
ABUSECH_AUTH_KEY=
HTTPBL_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# HTTPS geolocation requires a separate IP-API Pro key.
IP_API_KEY=
# Optional provider model overrides.
GROQ_MODEL=
GEMINI_MODEL=
OPENROUTER_MODEL=

# Enable VirusTotal only for public indicators you may share with it.
PHISHMATRIX_VT_SHARE=0
# Web Risk defaults to the URL origin. Opt in to sending public paths, with query values removed.
PHISHMATRIX_WEBRISK_PATH_SHARE=0
# Send query-free URLs to URLhaus only for public indicators.
PHISHMATRIX_URLHAUS_PATH_SHARE=0
# Sends only the deterministic verdict and built-in rule IDs and titles.
PHISHMATRIX_AI_SUMMARY=0
# Optional DNS resolution and passive public-source lookups.
PHISHMATRIX_DNS_LOOKUPS=0
PHISHMATRIX_PUBLIC_INTEL=0
# Include reputation checks for established allowlisted root URLs.
PHISHMATRIX_INCLUDE_ALLOWLIST=0
PHISHMATRIX_INTEL_FILE=intel-snapshot.json
# Operator-provided, authorized Maltrail domain list.
PHISHMATRIX_MALTRAIL_FILE=

# Enterprise names protected by the offline email analyzer (comma-separated domains).
PHISHMATRIX_ENTERPRISE_DOMAINS=
