{
  "version": 2,
  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "static/**",
          "app/url_model.json",
          "app/kaggle_history.bin"
        ],
        "excludeFiles": [
          ".env",
          ".env.*",
          ".venv/**",
          "venv/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ]
}
